# NACA 0012 aerofoil at 4 degrees angle of attack, chord Reynolds number 6e6, k-omega SST (ADR 0142).
# The flow condition of the registry set-up of ADR 0092 (Ladson's condition); the mesh is that set-up's coarse O-grid.
# Units: chord c = 1 m, free stream U = 1 m/s. Variant: naca0012-aoa2.toml (2 degrees).
# The angle of attack appears four times below: initial velocity, far-field velocity, lift and drag directions.
title = "NACA 0012, alpha 4 deg, Re 6e6 (k-omega SST)"

[mesh]
# An OpenFOAM polyMesh folder, relative to this file's folder; built from meshes/naca0012-ogrid.recipe.toml by
# scripts/make_example_projects.py (the cylinder O-grid of ADR 0092 moved onto the NACA 0012 surface).
source = "file"
file = "../meshes/naca0012-ogrid"

[physics]
nu = 1.6666666666666667e-7   # Re = U c / nu = 6e6

[initial]
velocity = [0.9975640502598242, 0.0697564737441253, 0.0]   # (cos 4 deg, sin 4 deg, 0)

[boundaries.airfoil]
velocity = "fixed"   # no-slip wall

[boundaries.farfield]
velocity = "freestream"
velocity_value = [0.9975640502598242, 0.0697564737441253, 0.0]
pressure = "freestream"

[turbulence]
model = "k_omega_sst"

[solver]
algorithm = "simplec"
convection = "linear_upwind"
max_iterations = 2000   # the run stops here: the residual targets are not reached on this mesh (ADR 0142)

[output]
store_interval = 200   # a snapshot every 200 iterations, single precision
store_precision = "f32"
store_fields = ["ux", "uy", "p", "nut"]

[reports.cl]
type = "force_coefficient"
patch = "airfoil"
direction = [-0.0697564737441253, 0.9975640502598242, 0.0]   # lift: normal to the free stream
a_ref = 0.1   # c x depth
u_ref = 1.0

[reports.cd]
type = "force_coefficient"
patch = "airfoil"
direction = [0.9975640502598242, 0.0697564737441253, 0.0]   # drag: along the free stream
a_ref = 0.1
u_ref = 1.0
