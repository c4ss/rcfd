{
  "name": "rcfd-studio-web",
  "version": "0.0.0",
  "private": true,
  "description": "rcfd Studio, the Electron desktop front end of rcfd (F-448 and the Studio roadmap of ADR 0800). F-801 hardened shell (G10), F-802 design tokens and primitives, F-803 client of the solver service, with their Playwright tests. No surfaces yet.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.test.json",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.node.json",
    "package:dir": "node scripts/package-dir.mjs",
    "test": "npm run build && npm run package:dir && playwright test",
    "test:unit": "playwright test --project=unit",
    "tokens:css": "node --experimental-strip-types scripts/write-tokens-css.mjs",
    "gallery": "node scripts/open-gallery.mjs",
    "bench:cold-start": "node scripts/measure-cold-start.mjs",
    "bench:service": "node scripts/measure-service.mjs",
    "start": "electron ."
  },
  "dependencies": {
    "@fontsource/archivo": "5.3.0",
    "@react-three/fiber": "9.8.2",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
