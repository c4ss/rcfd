{
  "name": "rcfd-studio-web",
  "version": "0.0.0",
  "private": true,
  "description": "rcfd Studio, the Electron desktop front end of rcfd (F-448 and the Studio roadmap of ADR 0800). F-800 skeleton: no service client and no surfaces yet.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.node.json",
    "start": "electron ."
  },
  "dependencies": {
    "@fontsource/archivo": "5.3.0",
    "@react-three/fiber": "9.8.2",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
